# ========== CONFIGURACIÓN DE OFERTAS LABORALES ==========

# Categorías de empleo (rotación automática cada 12 horas)
JOB_CATEGORIES=frontend,backend,mobile,designer,database,data-analyst,cybersecurity

# Niveles de experiencia a buscar
JOB_LEVELS=junior,trainee,entry-level

# Ubicaciones (separadas por comas) - SOLO PAÍSES LATINOAMERICANOS
JOB_LOCATIONS=remote,Mexico,Nicaragua,Guatemala,El Salvador,Colombia,Brasil,Ecuador,Peru,Chile,Argentina,Uruguay,Paraguay

# Solo trabajos remotos (true/false)
SEARCH_REMOTE_ONLY=false

# Máximo de días de antigüedad de ofertas (30 = último mes)
MAX_DAYS_OLD=30

# ========== APIs DE BÚSQUEDA DE EMPLEO ==========

# RapidAPI Key (para JSearch - LinkedIn, Indeed, Glassdoor)
# Obtener en: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=f98e0a58bdmsh415d0a38f142383p1d6cd8jsn112854a634f1

# USAJOBS API (opcional - solo para trabajos de gobierno USA)
# Obtener en: https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ========== CONFIGURACIÓN DE WHATSAPP ==========

# Nombre del grupo de WhatsApp al que enviar las ofertas
TARGET_GROUP_NAME=Club Dev Maval

# ========== GEMINI AI ==========

# API Key de Gemini AI para generar descripciones mejoradas
